# Optional local development image for the disposable Indra sandbox.
# This image contains tools only; project files are copied separately into a temporary container.
# Review this Dockerfile, then build it manually with scripts/build_sandbox_image.ps1.
FROM python:3.12-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    npm_config_update_notifier=false

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       ca-certificates git build-essential nodejs npm \
    && rm -rf /var/lib/apt/lists/*

# Includes Indra's test/runtime dependencies plus common offline QA utilities.
# Project-specific dependencies must be deliberately baked into a reviewed image.
RUN python -m pip install --no-cache-dir \
      fastapi==0.128.2 \
      'uvicorn[standard]==0.48.0' \
      httpx==0.28.1 \
      python-dotenv==1.2.2 \
      pytest==9.0.2 \
      ruff

WORKDIR /workspace
