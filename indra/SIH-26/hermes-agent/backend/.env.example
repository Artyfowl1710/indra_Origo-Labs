# Workbench server environment — copy to .env and fill in values.
# Never commit .env to version control.

# ── Required ──────────────────────────────────────────────────────────────────
# Public URL that INDRA clients will use to reach this server. The native
# installer uses loopback; enterprise deployments can override it.
PUBLIC_API_BASE=http://127.0.0.1:8000

# Generated uniquely during installation. Do not copy a developer credential.
WORKBENCH_API_KEY=

# Optional. Leave unset to use the current user's Documents/Obsidian Vault.
OBSIDIAN_VAULT_PATH=

# ── Artifactory (required for air-gapped model downloads) ────────────────────
ARTIFACTORY_URL=http://artifactory.internal/artifactory
ARTIFACTORY_REPO=models
ARTIFACTORY_USER=
ARTIFACTORY_TOKEN=

# ── RAG ───────────────────────────────────────────────────────────────────────
# Must match the name of a registered embedding model
RAG_EMBEDDING_MODEL_ID=

# ── Feature flags ─────────────────────────────────────────────────────────────
# Set to true ONLY in non-air-gapped environments (laptop demo, Kaggle)
ALLOW_HF_DOWNLOAD=false
ALLOW_RAW_WORKFLOW=false

# ── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333

# ── Lifecycle ─────────────────────────────────────────────────────────────────
LIFECYCLE_POLL_INTERVAL_S=60
MODEL_DEFAULT_TTL_S=600
