# Compatibility configuration for the earlier standalone app/ entry point.
# Native Indra desktop: configure credentials in Keys and select a provider in Models.
# A local gateway must be installed and configured separately.
OPENAI_BASE_URL=http://127.0.0.1:8100/v1
OPENAI_API_KEY=local
# Set to auto to select the first model advertised by /v1/models.
MODEL=auto
INDRA_AUTO_DETECT_MODEL=true
INDRA_REQUEST_TIMEOUT=120
INDRA_CONNECT_TIMEOUT=3

# Existing local services (diagnostics only unless explicitly integrated).
LLAMA_SWAP_URL=http://127.0.0.1:8100
LLAMA_SERVER_URL=http://127.0.0.1:5800
QDRANT_URL=http://127.0.0.1:6333
WORKBENCH_API_URL=http://127.0.0.1:8000

# Optional read-only semantic retrieval (disabled by default).
# Enable only after Qdrant contains vectors made by this exact embedding model/dimension.
# The OpenAI-compatible endpoint must implement POST /v1/embeddings.
QDRANT_COLLECTION=
QDRANT_API_KEY=
EMBEDDING_BASE_URL=http://127.0.0.1:8100/v1
EMBEDDING_API_KEY=local
EMBEDDING_MODEL=

# First-party Knowledge Studio RAG embeddings are an explicit, separate opt-in.
# Leave RAG_EMBEDDING_MODEL blank for local-only SQLite/FTS5 lexical retrieval.
# When set, chunk/query text is sent to this OpenAI-compatible embedding endpoint.
RAG_EMBEDDING_MODEL=
RAG_EMBEDDING_BASE_URL=http://127.0.0.1:8100/v1
RAG_EMBEDDING_API_KEY=local

# Keep paths local to this project or set absolute Windows paths.
INDRA_WORKSPACE=./workspace
INDRA_DATA_DIR=./data
INDRA_PROFILE=auto
INDRA_MAX_STEPS=14
INDRA_MAX_FILE_BYTES=200000
INDRA_MAX_TOOL_CALLS=32
INDRA_MAX_RUN_SECONDS=240
INDRA_MAX_TOOL_RESULT_CHARS=12000
INDRA_MAX_TOOL_SECONDS=45
INDRA_MAX_CONTEXT_CHARS=24000
INDRA_MAX_CONCURRENT_RUNS=2
INDRA_SMOKE_TIMEOUT=45
INDRA_BACKUP_DIR=./data/backups

# Public web research and scraping. Agent-initiated access always asks in the interactive UI.
INDRA_AGENT_NETWORK_POLICY=ask  # ask | deny
INDRA_WEB_TOOLS_ENABLED=true
INDRA_WEB_ALLOW_HTTP=false
INDRA_WEB_MIN_INTERVAL_SECONDS=1.0
# robots.txt is respected by default; set false only for compliant research cases where policy explicitly permits it.
INDRA_WEB_RESPECT_ROBOTS=true
# Optional comma-separated domain allowlist (example: arxiv.org,github.com). Blank allows any public HTTPS host.
INDRA_WEB_ALLOWED_DOMAINS=

# Composable extensions. Skills are Markdown; plugin services must be explicitly enabled loopback HTTP JSON.
INDRA_ENABLE_LOCAL_HTTP_PLUGINS=false
INDRA_SKILLS_DIR=./skills
INDRA_PLUGINS_DIR=./plugins

# Parallel read-only child agents. Keep at 1–2 on low-memory local inference servers.
INDRA_PARALLEL_SUBTASKS=2
# Cross-request child model-call cap protects a local server from nested parallelism.
INDRA_MAX_ACTIVE_CHILDREN=2
# Total delegated nodes per parent agent run (parallel_tasks + task_graph combined).
INDRA_MAX_CHILD_TASKS_PER_RUN=6

# Optional Docker sandbox. No host-shell fallback; commands run in a disposable copy with --network=none.
INDRA_ENABLE_DOCKER_SANDBOX=false
INDRA_SANDBOX_IMAGE=python:3.12-slim
# INDRA_DOCKER_BINARY=C:\Program Files\Docker\Docker\resources\bin\docker.exe
# Bounded Docker sandbox resources. Hard ceilings are enforced by the harness.
# Memory 512–4096 MB; CPUs 0.5–4; PIDs 64–512; workspace tmpfs 128–512 MB.
INDRA_SANDBOX_MEMORY_MB=1024
INDRA_SANDBOX_CPUS=2
INDRA_SANDBOX_PIDS=256
INDRA_SANDBOX_WORKSPACE_TMPFS_MB=256

# Optional hosted OpenAI-compatible profile for later evaluation.
# OpenRouter example: https://openrouter.ai/api/v1 and dots-studio/dots-3-note-preview:free.
# Put a real key only in your private .env, never in this template or a commit.
# The app defaults to the local gateway above. No hosted API request is sent until you switch profiles and run a chat/smoke test.
# Hosted profile requires HTTPS and both a base URL + API key.
INDRA_HOSTED_BASE_URL=
INDRA_HOSTED_API_KEY=
INDRA_HOSTED_MODEL=auto

# Remote access is disabled by default. Setup script creates a random token for private Tailscale access.
INDRA_REMOTE_ACCESS_ENABLED=false
# INDRA_REMOTE_ACCESS_TOKEN=generate-with-enable_remote_tailscale.ps1; do not commit or share it

# Security: PDF parsing runs in-process. Leave disabled unless you trust every PDF source.
INDRA_ALLOW_UNSANDBOXED_PDF=false
